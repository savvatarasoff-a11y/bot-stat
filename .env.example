# Токен от @BotFather — единственная обязательная переменная
BOT_TOKEN=

# Необязательно:
# ADMIN_IDS=5349009098          # через запятую
# DB_PATH=data/bot.db
# BROADCAST_RATE=25             # сообщений в секунду (лимит Telegram ~30)
# REQUIRED_CHANNELS=@TripleGifts  # обязательная подписка (через запятую; пусто — выключить)

# --- Комментатор (python -m commenter), юзербот на Telethon ---
# API_ID / API_HASH — с https://my.telegram.org → API development tools
# API_ID=
# API_HASH=
# CHANNEL=@channel                # канал: @username, ссылка t.me/... или -100id
# COMMENTS=Первый! | Я тут        # тексты через «|», выбираются по очереди в случайном порядке
# COMMENTS_FILE=comments.txt      # или файл: комментарии через пустую строку (можно многострочные)
# SESSION=data/commenter          # файл сессии или строка StringSession
# COMMENT_DELAY=0                 # пауза перед отправкой, сек
# POLL_INTERVAL=0                 # доп. опрос канала, сек (например 1); 0 — выкл
# AUTO_JOIN=1                     # вступать в канал и чат обсуждений автоматически
